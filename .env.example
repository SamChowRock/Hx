NODE_ENV=development
DATABASE_URL=postgresql://scaffold:scaffold@localhost:5432/scaffold?schema=public
PORT=3000
LOG_LEVEL=debug
API_CORS_ORIGINS=http://localhost:5173
SERVICE_NAME=nestjs-production-scaffold
TRUST_PROXY=false
AUTH_SECRET=replace-with-a-random-32-character-minimum-secret
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@example.test
# Set to twilio and provide all three Twilio values to enable phone registration.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WEB_APP_ORIGIN=http://localhost:5173
API_PUBLIC_ORIGIN=http://localhost:3000
# Set all four values to enable a standards-compliant OIDC provider.
OIDC_PROVIDER_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set all three values after a WeChat Open Platform website application is approved.
WECHAT_PROVIDER_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
